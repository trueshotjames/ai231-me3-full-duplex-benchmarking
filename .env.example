# Copy to .env and fill in the key of the judge you use (one is enough). Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NOUS_API_KEY=            # Hermes (Nous Research): https://portal.nousresearch.com
# any other OpenAI-compatible server (choose provider "custom" / [h]):
JUDGE_BASE_URL=
JUDGE_API_KEY=

# --- where the assistant is (only if fd-benchmark is NOT cloned inside the assistant's project folder)
FDBENCH_PROJECT=            # e.g. C:\Users\me\Machine Exercise 3   or   /home/pi/ME3
FDBENCH_ASSISTANT_PYTHON=   # default: PROJECT/.venv/...python
# --- on the Pi: the laptop's address, so `python launch_assistant.py` needs no --url
FDBENCH_URL=                # e.g. ws://192.168.1.10:8791
